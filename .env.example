# Copy to .env.local for local development. On Vercel, set these in the project's environment variables.

# Public address of the Hub, without a trailing slash. The connector address is this + /api/mcp.
# Claude compares it character for character with what people paste, so choose it once.
HUB_URL=http://localhost:3210
# On Vercel set this to the public address for Production and Preview. After changing any
# variable on Vercel, redeploy: a running deployment keeps the values it was built with.

# The exact Google addresses that are let in, separated by commas. No domains, no wildcards.
ALLOWED_EMAILS=ada@example.com,ben@example.com
# Optional. Email domains whose every address is let in, comma-separated, for example: example.com
ALLOWED_DOMAINS=

# Optional. Owner shown for the built-in harness. Defaults to the first allowed address.
BUILT_IN_OWNER_EMAIL=
BUILT_IN_OWNER_NAME=

# Clerk application: sign-in for the dashboard, and the sign-in server for the connector.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stops Clerk from creating a temporary application of its own when no keys are set.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=true

# Turns off the Clerk SDK's telemetry.
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Local development only (`next dev`; ignored on Vercel). Test identities for scripts/smoke.mjs:
# a request carrying "Authorization: Bearer dev:<address>" is accepted for these addresses.
DEV_IDENTITY_EMAILS=ada@example.com,ben@example.com,stranger@example.com

# Local development only. Shows the pages as this address without a Google sign-in.
DEV_SESSION_EMAIL=

# Neon Postgres. On Vercel the Neon integration sets it; locally copy it with `vercel env pull`.
DATABASE_URL=
# Local development only: keeps local and check-script data in tables named dev_*.
HUB_TABLE_PREFIX=dev_
