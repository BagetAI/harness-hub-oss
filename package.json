{
  "name": "harness-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname localhost --port 3210",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/register-ts.mjs --test --test-reporter=spec \"tests/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "check:store": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env.local scripts/check-store.mjs",
    "clean:dev": "node --env-file=.env.local scripts/clean-dev.mjs"
  },
  "dependencies": {
    "@clerk/mcp-tools": "^0.9.0",
    "@clerk/nextjs": "^7.9.25",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "mcp-handler": "^2.3.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2"
}
